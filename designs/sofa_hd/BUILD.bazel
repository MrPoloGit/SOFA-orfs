load("@bazel-orfs//:openroad.bzl", "orfs_flow")

# SOFA HD — 12×12 CLB, W=40, sky130hd standard cells only.
# RTL (src/*.v) and SDC (src/fpga_top.sdc) are committed to the repo;
# generate them first with `make runOpenFPGA` in the SOFA repo.
orfs_flow(
    name = "sofa_hd",
    top = "fpga_top",
    verilog_files = glob(
        ["src/**/*.v"],
        exclude = [
            "src/fabric_netlists.v",
            "src/top_include_netlists.v",
            "src/sub_module/fpga_top.v",  # Caravel SoC wrapper, conflicts with top
        ],
    ),
    pdk = "@orfs//flow:sky130hd",
    sources = {
        "SDC_FILE": ["src/fpga_top.sdc"],
        "FASTROUTE_TCL": ["fastroute.tcl"],
        # PDN_TCL omitted — use sky130hd platform default.
        # Our custom pdn.tcl was crashing OpenROAD's PDN tool.
    },
    arguments = {
        "DIE_AREA": "0 0 2800 2800",
        "CORE_AREA": "10 10 2790 2790",
        "PLACE_DENSITY": "0.40",
        "MIN_ROUTING_LAYER": "met1",
        "MAX_ROUTING_LAYER": "met5",
    },
)
