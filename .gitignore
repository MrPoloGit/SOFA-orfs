# ORFS run outputs (large, regeneratable)
results/
logs/
objects/

# Generated RTL — sourced from sofa/ submodule at build time
designs/*/src/*.v
designs/*/src/**/*.v
# SDC files are the original SOFA tapeout constraints — track them
!designs/*/src/*.sdc
# OpenFPGA instance map (generated metadata, not needed for synthesis)
designs/*/src/InstancesMap.txt

# Custom cell GDS files (large binary, reference from SOFA repo)
custom_cells/*.gds

# Bazel
bazel-*
!bazel-orfs
MODULE.bazel.lock
.bazelrc.user

# OS files
.DS_Store
*.swp
*~
plan.md

# Python
__pycache__/
*.pyc
